    {
      "skillId": 653,
      "name": "慢镜头",
      "hitRule": "非必中",
      "common": [],
      "phases": [
        {
          "label": "无负面速度",
          "when": "对手速度强化等级 ≥ 0",
          "effect": "本次威力为 100。"
        },
        {
          "label": "速度降低 1～2 级",
          "when": "对手速度强化等级为 -1 或 -2",
          "effect": "本次威力为 160。"
        },
        {
          "label": "速度降低 3～5 级",
          "when": "对手速度强化等级为 -3、-4 或 -5",
          "effect": "本次威力为 200。"
        },
