{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rocowiki-api", "main": "src/index.ts", "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "d1_databases": [{"binding": "DB", "database_name": "rocowiki", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../database/migrations"}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "ENVIRONMENT": "development", "WEB_ORIGIN": "http://localhost:3000", "API_ORIGIN": "http://localhost:8787",
    "SITE_URL": "http://localhost:3000", "OIDC_ISSUER": "", "OIDC_CLIENT_ID": "",
    "GITHUB_OWNER": "", "GITHUB_REPO": "", "GITHUB_DEFAULT_BRANCH": "main", "GITHUB_APP_ID": "", "GITHUB_INSTALLATION_ID": "", "GITHUB_OAUTH_CLIENT_ID": "",
    "GITCODE_REMOTE_URL": "", "SUBMISSIONS_ENABLED": "true", "PUBLISH_ENABLED": "false"
  },
  "env": {"production": {
    "name": "rocowiki-api-production",
    "d1_databases": [{"binding": "DB", "database_name": "rocowiki-production", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../database/migrations"}],
    "vars": {
      "ENVIRONMENT": "production", "WEB_ORIGIN": "https://wiki.rocoai.app", "API_ORIGIN": "https://api.rocoai.app", "SITE_URL": "https://wiki.rocoai.app",
      "OIDC_ISSUER": "", "OIDC_CLIENT_ID": "", "GITHUB_OWNER": "myouo", "GITHUB_REPO": "rocowiki", "GITHUB_DEFAULT_BRANCH": "main",
      "GITHUB_APP_ID": "", "GITHUB_INSTALLATION_ID": "", "GITHUB_OAUTH_CLIENT_ID": "", "GITCODE_REMOTE_URL": "",
      "SUBMISSIONS_ENABLED": "false", "PUBLISH_ENABLED": "false"
    }
  }}
}
